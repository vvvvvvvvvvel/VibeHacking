{
    "name": "caido-vibe-hacking",
    "private": true,
    "packageManager": "pnpm@10.28.2+sha512.41872f037ad22f7348e3b1debbaf7e867cfd448f2726d9cf74c08f19507c31d2c8e7a11525b983febc2df640b5438dee6023ebb1f84ed43cc2d654d2bc326264",
    "version": "4.0.0",
    "description": "Caido MCP plugin",
    "main": "index.js",
    "scripts": {
        "sync:version": "node scripts/sync-version.mjs",
        "prebuild": "node scripts/sync-version.mjs",
        "build": "pnpm exec caido-dev build .",
        "check": "pnpm test && pnpm typecheck && pnpm typecheck:scripts && pnpm exec eslint . && pnpm exec prettier --check . && pnpm gql:validate",
        "test": "tsx scripts/test-backend.ts",
        "typecheck": "pnpm --filter backend typecheck && pnpm --filter frontend typecheck",
        "typecheck:scripts": "cd packages/backend && pnpm exec tsc --ignoreConfig --noEmit --target esnext --module esnext --moduleResolution bundler --strict --skipLibCheck --esModuleInterop --types node,@caido/quickjs-types,@caido/sdk-backend ../../scripts/*.ts ../../scripts/mcp-smoke/*.ts",
        "gql:validate": "tsx scripts/validate-gql.ts",
        "watch": "pnpm exec caido-dev watch .",
        "format": "prettier --write .",
        "smoke": "tsx scripts/mcp-smoke/index.ts",
        "smoke:integration": "tsx scripts/mcp-smoke/integration.ts",
        "release:tag": "node -p \"require('./package.json').version\" | xargs -I{} sh -c 'git tag v{} && git push origin v{}'"
    },
    "keywords": [
        "MCP",
        "caido"
    ],
    "author": "vvvvvvvvvvel",
    "license": "MIT",
    "devDependencies": {
        "@caido-community/dev": "^0.1.7",
        "@caido/eslint-config": "^0.11.0",
        "@types/node": "^26.6.5",
        "@vitejs/plugin-vue": "^6.0.10",
        "autoprefixer": "^10.6.1",
        "eslint": "^9.39.5",
        "graphql": "^17.0.2",
        "postcss": "^8.5.31",
        "postcss-prefixwrap": "^1.59.1",
        "prettier": "^3.9.10",
        "tsx": "^4.23.15",
        "typescript": "^6.0.3"
    },
    "pnpm": {
        "overrides": {
            "body-parser": "2.4.0",
            "brace-expansion@1.1.18": "1.1.21",
            "brace-expansion@2.1.4": "2.1.7",
            "brace-expansion@5.0.9": "5.0.12",
            "cookie@0.6.0": "0.7.2",
            "esbuild@0.24.2": "0.25.12",
            "fast-uri": "3.1.9",
            "glob@11.0.1": "11.1.0",
            "hono": "4.13.11",
            "ip-address": "10.7.4",
            "proxy-addr": "2.0.8",
            "qs@6.13.0": "6.16.1",
            "sharp@0.34.5": "0.35.5",
            "source-map-js@1.2.1": "1.2.2",
            "vite@6.0.7": "6.4.5",
            "ws@8.18.0": "8.22.0",
            "yaml@2.8.2": "2.9.1",
            "zod@3.24.1": "4.6.7"
        }
    }
}
